<?xml version="1.0"?>
<TriggernometryExport Version="1">
  <ExportedFolder FFXIVJobFilterEnabled="false" FFXIVJobFilter="0" ZoneFilterEnabled="false" EventFilterEnabled="false" Id="a1b2c3d4-0001-4000-8000-000000000001" Name="FF14 Discord Notify (Portable) - Ratio Fix" Enabled="true">
    <Folders>
      <Folder FFXIVJobFilterEnabled="false" FFXIVJobFilter="0" ZoneFilterEnabled="false" EventFilterEnabled="false" Id="a1b2c3d4-0002-4000-8000-000000000001" Name="[1] Settings - 설정" Enabled="true">
        <Folders />
        <Triggers>
          <Trigger Enabled="true" Source="Log" Name="Set Webhook URL" Id="a1b2c3d4-0010-4000-8000-000000000002" RegularExpression="^.*?00:0038::!notify_set (?&lt;url&gt;https://discord\.com/api/webhooks/[\w\-/]+)">
            <Actions>
              <Action OrderNumber="1" ActionType="Variable" VariableName="ff14notify_webhook" VariableOp="SetString" VariableExpression="${url}" />
              <Action OrderNumber="2" ActionType="GenericJson" JsonEndpointExpression="${url}" JsonPayloadExpression="{&quot;content&quot;:&quot;Webhook Linked!&quot;}" />
            </Actions>
          </Trigger>
        </Triggers>
      </Folder>

      <Folder FFXIVJobFilterEnabled="false" FFXIVJobFilter="0" ZoneFilterEnabled="false" EventFilterEnabled="false" Id="a1b2c3d4-0003-4000-8000-000000000001" Name="[2] Alerts - 알림" Enabled="true">
        <Folders />
        <Triggers>
          <!-- 파티원 참가 (개선판: 내장 변수 활용) -->
          <Trigger Enabled="true" Source="Log" Name="Party Join (Enhanced)" Id="a1b2c3d4-0020-4000-8000-000000000010" RegularExpression="^.*?00:(2039|2239)::(?&lt;name&gt;.+?)(?&lt;server&gt;카벙클|초코보|모그리|톤베리|펜리르)? 님이 파티에 (참가|참여)했습니다\.">
            <Actions>
              <!-- 1: 즉시 Triggernometry 내장 파티 리스트에서 직업 ID 추출 후 한글명 변환 -->
              <Action OrderNumber="1" ActionType="Variable" VariableName="ff14_pjob_resolved" VariableOp="SetString" VariableExpression="${_cs:var p = command.ffxiv.GetPartyList(); var m = p.FirstOrDefault(x =&gt; x.Name == &quot;${name}&quot;); if (m == null) return &quot;알 수 없음&quot;; return new System.Collections.Generic.Dictionary&lt;int,string&gt;{{19,&quot;팔라딘&quot;},{20,&quot;승려&quot;},{21,&quot;전사&quot;},{22,&quot;용기사&quot;},{23,&quot;음유시인&quot;},{24,&quot;백마도사&quot;},{25,&quot;흑마도사&quot;},{27,&quot;소환사&quot;},{28,&quot;학자&quot;},{30,&quot;닌자&quot;},{31,&quot;기공사&quot;},{32,&quot;암흑기사&quot;},{33,&quot;점성술사&quot;},{34,&quot;사무라이&quot;},{35,&quot;적마도사&quot;},{37,&quot;건브레이커&quot;},{38,&quot;무도가&quot;},{39,&quot;리퍼&quot;},{40,&quot;현자&quot;},{41,&quot;바이퍼&quot;},{42,&quot;회화술사&quot;}}.TryGetValue((int)m.JobId, out var j) ? j : &quot;알 수 없음&quot;;}">
                <Condition Enabled="false" Grouping="Or" />
              </Action>
              <!-- 2: 즉시 웹훅 전송 (Sleep 제거) -->
              <Action OrderNumber="2" ActionType="GenericJson" JsonEndpointExpression="${var:ff14notify_webhook}" JsonPayloadExpression="{&quot;embeds&quot;:[{&quot;title&quot;:&quot;Party Join (Verified)&quot;,&quot;description&quot;:&quot;**${name}${if:${server}:@${server}:}**\n직업: ${var:ff14_pjob_resolved}&quot;,&quot;color&quot;:3066993}]}">
                <Condition Enabled="false" Grouping="Or" />
              </Action>
            </Actions>
          </Trigger>
        </Triggers>
      </Folder>
    </Folders>
  </ExportedFolder>
</TriggernometryExport>
